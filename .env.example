# Entra application (Microsoft Graph application permission)
TENANT_ID=<tenant-id>
CLIENT_ID=<client-id>
CLIENT_SECRET=<newly-rotated-client-secret>

# Require this header on every business endpoint: X-API-Key
API_KEY=<generate-a-long-random-demo-api-key>

# SharePoint
SITE_ID=skysecuretech.sharepoint.com,d4fc947c-51ef-43a7-ad04-cc8aa07fe5d5,0520176d-be92-4f4e-b345-4c4e52e7cc98
TRACKER_LIST_ID=3aa1fd11-8004-4e93-985e-a8ef3bda2188
HISTORY_LIST_ID=6e08da35-a367-4456-8d51-f34b125b97dd
REVIEW_LIST_ID=dd591608-8a99-4a0a-8702-20e1e71d46c2

# Azure OpenAI / Microsoft Foundry model deployment
AOAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AOAI_API_KEY=<newly-rotated-azure-openai-key>
AOAI_DEPLOYMENT=<gpt-4.1-deployment-name>
AOAI_API_VERSION=2024-10-21
AOAI_TIMEOUT_SECONDS=90
AOAI_MAX_TOKENS=4000

# Raw email/attachment limits
MAX_ATTACHMENT_BYTES=10485760
MAX_EMAIL_BYTES=26214400
MAX_EXTRACTED_TEXT_CHARS=60000
MAX_PDF_PAGES=12

# Business rules
SLA_DAYS_CONFIRMATION=2
SLA_DAYS_DISPATCH=3
SLA_DAYS_PRODUCTION_START=3
AT_RISK_WINDOW_DAYS=3
LOW_CONFIDENCE_THRESHOLD=0.75
